# =========================================================
# SMART DIGITAL LOCKER - ENVIRONMENT CONFIGURATION TEMPLATE
# Spring Boot (Java) + MySQL + React Architecture
# =========================================================

# Server Port
PORT=8080

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/smart_digital_locker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication
# IMPORTANT: In production, supply a random key of at least 32 characters (256 bits)
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters_production
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API Base URL (Used by Vite React App)
VITE_API_BASE_URL=http://localhost:8080/api
