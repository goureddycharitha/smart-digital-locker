# ==========================================
# SMART DIGITAL LOCKER - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Relative to project root or absolute path)
DB_PATH=./database/locker.sqlite

# JWT Authentication
# IMPORTANT: In production, generate a secure random string of at least 32 characters
JWT_SECRET=your_super_secret_jwt_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
# Maximum file size in bytes (10MB = 10485760 bytes)
MAX_FILE_SIZE=10485760

# Allowed CORS origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
