{
  "name": "smart-digital-locker-root",
  "version": "2.0.0",
  "description": "Smart Digital Locker - Full-Stack Spring Boot + MySQL + React Document Vault",
  "scripts": {
    "start:backend": "java -jar backend/target/smart-digital-locker-backend-1.0.0.jar",
    "dev:backend": "node scripts/run-mvn.js -f backend/pom.xml spring-boot:run",
    "build:backend": "node scripts/run-mvn.js -f backend/pom.xml clean package -DskipTests",
    "test:backend": "node scripts/run-mvn.js -f backend/pom.xml test",
    "start:frontend": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test": "node scripts/run-mvn.js -f backend/pom.xml test",
    "db:status": "node scripts/check-mysql-db.js",
    "db:migrate": "node scripts/migrate-sqlite-to-mysql.js"
  },
  "keywords": [
    "digital-locker",
    "spring-boot",
    "java",
    "mysql",
    "react",
    "jwt",
    "security"
  ],
  "author": "Smart Digital Locker Team",
  "license": "MIT"
}
